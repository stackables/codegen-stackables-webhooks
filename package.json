{
	"name": "codegen-stackables-webhooks",
	"version": "2.2.3",
	"description": "GraphQL Code Generator plugin for Stackables webhooks",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"keywords": [
		"cloudevents",
		"router",
		"stackables",
		"webhooks"
	],
	"files": [
		"build/*"
	],
	"scripts": {
		"prepack": "tsc",
		"test": "node --experimental-transform-types --test test/*.test.ts",
		"test:coverage": "node --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info --experimental-transform-types --test test/*.test.ts",
		"ci:publish": "tsc && changeset publish",
		"knip": "knip"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@graphql-tools/load": "^9.0.2",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.19.2",
		"axios": "^1.6.7",
		"knip": "6.42.0",
		"typescript": "^7.0.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/stackables/codegen-stackables-webhooks.git"
	},
	"author": "",
	"license": "MIT",
	"packageManager": "pnpm@12.14.0",
	"bugs": {
		"url": "https://github.com/stackables/codegen-stackables-webhooks/issues"
	},
	"homepage": "https://github.com/stackables/codegen-stackables-webhooks#readme",
	"dependencies": {
		"@graphql-codegen/plugin-helpers": "^7.4.2",
		"change-case-all": "^2.1.0",
		"graphql": "^16.8.1",
		"graphql-request": "^7.4.0"
	}
}
